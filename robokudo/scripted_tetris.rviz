Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane: XY
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/MarkerArray
      Name: Receiving CAD meshes
      Enabled: true
      Topic:
        Value: /scripted_tetris/visual
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/MarkerArray
      Name: Receiving collision boxes
      Enabled: true
      Topic:
        Value: /scripted_tetris/collision
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 10
    - Class: rviz_default_plugins/TF
      Name: Receiving transforms
      Enabled: true
      Show Axes: true
      Show Arrows: false
      Show Names: true
      Marker Scale: 0.15
  Enabled: true
  Global Options:
    Background Color: 36; 36; 36
    Fixed Frame: map
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.2
      Focal Point:
        X: -0.1
        Y: -0.1
        Z: 0.95
      Pitch: 0.5
      Yaw: 0.8
Window Geometry:
  Width: 1280
  Height: 800
